rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['admin@gmail.com'];
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().disabled != true;
    }
    function isRestaurantOwner() { return isActiveAccount() && userData().role == 'restaurant'; }
    function isRider() { return isActiveAccount() && userData().role == 'rider'; }
    function ownsRestaurant(id) {
      return isRestaurantOwner() && get(/databases/$(database)/documents/restaurants/$(id)).data.ownerId == request.auth.uid;
    }
    function validUserCreate(userId) {
      return signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name','email','phone','photoURL','address','createdAt','updatedAt'
        ])
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer');
    }
    function safeUserUpdate(userId) {
      return isActiveAccount() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','phone','photoURL','address','riderOnline','updatedAt'
        ]);
    }
    function shopMayUpdateOrder() {
      return isRestaurantOwner()
        && resource.data.restaurantId == userData().restaurantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelReason','updatedAt'])
        && (
          (resource.data.status == 'pending' && request.resource.data.status in ['accepted','cancelled']) ||
          (resource.data.status == 'accepted' && request.resource.data.status in ['preparing','cancelled']) ||
          (resource.data.status == 'preparing' && request.resource.data.status in ['ready','cancelled'])
        );
    }
    function customerMayCancelOrder() {
      return isActiveAccount()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelReason','updatedAt']);
    }
    function riderMayUpdateOrder() {
      return isRider()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','riderId','driverName','driverPhone','updatedAt'
        ])
        && (
          (resource.data.status == 'ready'
            && !('riderId' in resource.data)
            && userData().riderOnline == true
            && request.resource.data.status == 'delivering'
            && request.resource.data.riderId == request.auth.uid)
          ||
          (resource.data.riderId == request.auth.uid
            && resource.data.status == 'delivering'
            && request.resource.data.status == 'completed'
            && request.resource.data.riderId == resource.data.riderId)
        );
    }

    match /restaurants/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        ownsRestaurant(id)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','description','image','coverImage','address','phone',
          'deliveryTime','status','updatedAt'
        ])
      );
    }

    match /products/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        isRestaurantOwner()
        && request.resource.data.restaurantId == userData().restaurantId
        && ownsRestaurant(request.resource.data.restaurantId)
        && request.resource.data.keys().hasOnly([
          'name','price','restaurantId','restaurantName','category','image',
          'description','available','createdAt','updatedAt'
        ])
      );
      allow update: if isAdmin() || (
        ownsRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','price','restaurantName','category','image','description','available','updatedAt'
        ])
      );
      allow delete: if isAdmin() || ownsRestaurant(resource.data.restaurantId);
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if validUserCreate(userId) || isAdmin();
      allow update: if safeUserUpdate(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isActiveAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'userId','restaurantId','restaurantName','items','subtotal','total','address','paymentMethod','status'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (isRestaurantOwner() && resource.data.restaurantId == userData().restaurantId) ||
        (isRider() && (resource.data.riderId == request.auth.uid ||
          (resource.data.status == 'ready' && userData().riderOnline == true)))
      );
      allow update: if isAdmin() || shopMayUpdateOrder() || riderMayUpdateOrder() || customerMayCancelOrder();
      allow delete: if isAdmin();
    }

    match /favorites/{id} {
      allow create: if isActiveAccount() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /promos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // A customer may only bump usedCount by exactly 1 (coupon use after an order)
      allow update: if isAdmin() || (
        isActiveAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
        && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
      );
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if isActiveAccount() && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }
    match /support_tickets/{id} {
      allow create: if isActiveAccount() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}